# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Projeto Integrador)
# Configure no painel de Secrets ou variáveis de ambiente do Google AI Studio / .env
# VITE_SUPABASE_URL: URL do seu projeto no Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Chave pública/anon do seu projeto no Supabase (Publishable key)
VITE_SUPABASE_ANON_KEY=""
